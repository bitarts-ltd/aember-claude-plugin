#!/bin/bash
# The headers Claude Code sends with each request to Aember's MCP
# server (the plugin's headersHelper), printed as a JSON object:
#
#   Authorization      the server's token, so Claude Code connects when
#                      Settings > MCP > Require token is on; left out
#                      when Aember isn't running or has no token
#   X-Claude-Code-PID  the Claude Code process that runs this, as the
#                      plugin's hooks send it, so Aember knows which
#                      session's connection works (strict mode)

discovery="$HOME/Library/Application Support/Aember/mcp-server.json"
token=''
if [ -f "$discovery" ]; then
    pid=$(/usr/bin/plutil -extract pid raw -o - "$discovery" 2> /dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2> /dev/null; then
        token=$(/usr/bin/plutil -extract token raw -o - "$discovery" 2> /dev/null)
    fi
fi
headers="\"X-Claude-Code-PID\": \"$PPID\""
# A token is letters and digits; anything else is not sent
if [[ $token =~ ^[0-9A-Za-z_-]+$ ]]; then
    headers="\"Authorization\": \"Bearer $token\", $headers"
fi
printf '{%s}\n' "$headers"
